{
  "name": "HomeSentinel",
  "version": "1.6.2",
  "description": "Monitor delle telecamere di Home Assistant con finestre PiP, allarme a tutto schermo e citofono",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build-win": "electron-builder --win --publish never",
    "build-appimage": "electron-builder --linux AppImage --publish never",
    "build-deb": "electron-builder --linux deb --publish never",
    "build-rpm": "electron-builder --linux rpm --publish never",
    "build-pacman": "electron-builder --linux pacman --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "version-patch": "npm version patch",
    "version-minor": "npm version minor",
    "version-major": "npm version major",
    "push tags": " git push --tags"
  },
  "keywords": [
    "home-assistant",
    "pip",
    "video"
  ],
  "author": {
    "name": "Carmine Pola",
    "email": "carminepola@devmin.it"
  },
  "homepage": "https://git.devmin.it/carmine/homesentinel-app",
  "repository": {
    "type": "git",
    "url": "https://git.devmin.it/carmine/homesentinel-app.git"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "it.devmin.homesentinel",
    "productName": "homesentinel",
    "publish": [
      {
        "provider": "generic",
        "url": "https://git.devmin.it/api/packages/carmine/generic/homesentinel/latest"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!docs/**",
      "!scripts/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb",
        "pacman"
      ],
      "icon": "assets/icons",
      "category": "Utility"
    },
    "pacman": {
      "packageName": "homesentinel"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3",
    "marked": "^18.1.1",
    "ws": "^8.22.0"
  }
}
